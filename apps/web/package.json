{
  "name": "@jp-learn/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "dev": "node --conditions=source ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && node --conditions=source ./node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.6.0",
    "@applemusic-like-lyrics/react": "0.6.0",
    "@base-ui/react": "^1.8.0",
    "@jp-learn/content": "workspace:*",
    "@jp-learn/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "1.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@jp-learn/api": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#music": "./src/music.ts",
    "#library": "./src/library.ts",
    "#App": "./src/App.tsx",
    "#index.css": "./src/index.css"
  }
}
