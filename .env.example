# Server-only. Never prefix these with VITE_. Private/public keys accept PEM or base64 PKCS8/SPKI.
NETEASE_APP_ID=
NETEASE_APP_SECRET=
NETEASE_PRIVATE_KEY=
NETEASE_PUBLIC_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NETEASE_SESSION_SECRET=
# Device metadata must match the values supported by your NetEase application type.
NETEASE_DEVICE_TYPE=openapi
NETEASE_DEVICE_OS=ncmcli
NETEASE_DEVICE_CHANNEL=ncmcli
NETEASE_DEVICE_BRAND=ncmcli
# official: only the developer API. hybrid: fall back to anonymous web playback on app permission failures.
NETEASE_PLAYBACK_PROVIDER=hybrid
