{
  "name": "jp-learn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jp-learn/web dev",
    "build": "pnpm -r build",
